{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usmcmin.com/data/wire-latest.schema.json",
  "title": "RESOLUTE Wire board",
  "description": "Editorial board payload for usmcmin.com/wire.html (Path B). Rush owns content; Max owns chrome. Draft until Principal APPROVE.",
  "type": "object",
  "required": [
    "schema_version",
    "ts_local",
    "edition",
    "board_date",
    "disclosure",
    "lead",
    "rails",
    "watch",
    "publish"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "cid": { "type": "string" },
    "ts_local": { "type": "string", "description": "Local stamp, e.g. 2026-08-08 17:00 EDT" },
    "board_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "edition": { "type": "string", "enum": ["daily", "am", "pm", "special"] },
    "title": { "type": "string", "default": "RESOLUTE Wire" },
    "dek": { "type": "string", "description": "Optional one-line masthead dek" },
    "disclosure": { "type": "string" },
    "lead": { "$ref": "#/$defs/item" },
    "rails": {
      "type": "object",
      "required": ["political", "civic", "tech"],
      "properties": {
        "political": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" },
          "minItems": 0,
          "maxItems": 6
        },
        "civic": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" },
          "minItems": 0,
          "maxItems": 6
        },
        "tech": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" },
          "minItems": 0,
          "maxItems": 6
        },
        "defense": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" },
          "minItems": 0,
          "maxItems": 4,
          "description": "Optional fourth rail; may fold into political/tech if chrome is 3-rail only"
        }
      },
      "additionalProperties": false
    },
    "watch": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" },
      "maxItems": 3
    },
    "footer_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "publish": {
      "type": "object",
      "required": ["state", "rights_summary"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "DRAFT_SAMPLE",
            "DRAFT",
            "REVIEW",
            "APPROVED",
            "LIVE",
            "EXPIRED"
          ]
        },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"] },
        "live_url": { "type": ["string", "null"] },
        "rights_summary": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "editor": { "type": "string" },
        "source_cache_ts": { "type": "string" },
        "generated_for": { "type": "string" },
        "chrome_owner": { "type": "string" },
        "not_included": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "channel",
        "hed",
        "insight",
        "url",
        "source",
        "rights"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable slug for the board item, e.g. tech-openai-astra-20260808"
        },
        "channel": {
          "type": "string",
          "enum": ["political", "civic", "tech", "defense", "watch"]
        },
        "hed": {
          "type": "string",
          "maxLength": 140,
          "description": "Board headline; may tighten source hed"
        },
        "insight": {
          "type": "string",
          "maxLength": 320,
          "description": "Original Rush BLUF insight — fair-use length; never full article dump"
        },
        "url": { "type": "string", "format": "uri" },
        "source": { "type": "string" },
        "source_tier": {
          "type": "string",
          "enum": [
            "PRIMARY_VENDOR",
            "TRADE_PRESS",
            "AUTHORIZED_COMMENTARY",
            "PUBLIC_RECORD",
            "WIRE_REPRINT"
          ]
        },
        "rights": {
          "type": "string",
          "enum": [
            "LINK_FAIR_USE",
            "PUBLIC_RECORD",
            "OWNED",
            "UNKNOWN_KILL"
          ]
        },
        "image": {
          "type": ["string", "null"],
          "description": "OG image URL if known and linkable; null = brand fallback"
        },
        "published": {
          "type": ["string", "null"],
          "description": "Source pub date if known (ISO or RSS original)"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
