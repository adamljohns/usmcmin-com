{
  "name": "usmcmin-battle-bro-sync",
  "private": true,
  "description": "Magic-link auth + habit sync API for The Family Captain Battle Brother module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create usmcmin-battle-bro",
    "db:migrate": "wrangler d1 execute usmcmin-battle-bro --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute usmcmin-battle-bro --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.28.0"
  }
}
